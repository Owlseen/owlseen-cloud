# Postgres. A workspace's credentials are stored per workspace, sealed, never here.
OWLSEEN_DATABASE_URL=postgres://user:password@localhost:5432/owlseen
# The direct address, for migrations, when OWLSEEN_DATABASE_URL goes through a pooler that refuses session settings. Optional.
OWLSEEN_DATABASE_URL_UNPOOLED=
# openssl rand -base64 32. Signs sessions: changing it signs everyone out.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Who may sign up and start workspaces, comma-separated. Anyone else needs an invitation, and can only join.
OWLSEEN_ADMINS=
# openssl rand -base64 32: seals every connection's credentials. Keep it safe: without it they can't be opened.
OWLSEEN_SECRETS_KEY=
# Addresses and passwords, unless a company's provider is set. Needs RESEND_API_KEY: a mailed link proves each address.
OWLSEEN_PASSWORD_SIGN_IN=false
# A company's own identity provider (any OpenID Connect server). When set, members sign in there and nowhere else.
# Redirect address to register with it: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Its name on the sign-in page.
OIDC_NAME=
# Google's OAuth app, for signing in unless a company's provider is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The instance's own mail to its members (sign-in links, invitations), through Resend. A workspace's own accounts are connected on its Connections page.
RESEND_API_KEY=
OWLSEEN_MAIL_FROM=Owlseen <no-reply@example.com>
# What the job at /api/cron/sync must be called with, as a bearer.
CRON_SECRET=
